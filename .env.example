# ==============================================================================
# TimeInvestor - Variables de Entorno y Configuración
# ==============================================================================
# Copia este archivo a '.env' y completa las variables según tus necesidades:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. SERVIDOR HTTP (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=true

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS LOCAL (SQLite + SQLAlchemy)
# ------------------------------------------------------------------------------
# Ruta de conexión para persistencia de tesis, snapshots de proyección y notas.
# Se inicializa automáticamente en el arranque si el archivo no existe.
DATABASE_URL=sqlite:///./backend/database/time_investor.db

# ------------------------------------------------------------------------------
# 3. CABLE SEMÁNTICO Y COPILOTO (LLM Router)
# ------------------------------------------------------------------------------
# Proveedor LLM para desestructurar tesis y generar interpretaciones cualitativas.
# Opciones disponibles:
#   - gemini : Utiliza Google Gemini 3.6 Flash mediante SDK oficial google-genai (Recomendado).
#   - openai : Compatible con GPT-4o-mini mediante API REST de OpenAI.
#   - ollama : Modelos locales offline (ej: llama3.2, mistral) vía Ollama en localhost.
#   - mock   : Parser semántico y heurístico offline sin necesidad de claves ni internet.
LLM_PROVIDER=gemini

# Google Gemini API Key:
# Puedes obtener una clave de API 100% gratuita con alta cuota en Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Opcional, solo si LLM_PROVIDER=openai):
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Endpoint de Ollama (Opcional, solo si LLM_PROVIDER=ollama):
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 4. CABLE DE INGESTA MACROECONÓMICA (FRED API)
# ------------------------------------------------------------------------------
# Clave de API de Federal Reserve Economic Data (FRED).
# Permite consultar miles de series macroeconómicas, energéticas e industriales.
# Puedes obtenerla gratis en menos de 1 minuto registrándote en:
# https://fred.stlouisfed.org/docs/api/api_key.html
# (Nota: Si se deja vacía, las consultas a series FRED fallan explícitamente salvo que ALLOW_SYNTHETIC_DATA=true, ver sección 7).
FRED_API_KEY=

# ------------------------------------------------------------------------------
# 5. CABLE PREDICTIVO DE SERIES TEMPORALES (Google TimesFM / Damped Holt)
# ------------------------------------------------------------------------------
# Opciones de motor predictivo (usado como valor por defecto/fallback):
#   - mock    : Suavizado exponencial amortiguado (Holt linear trend) con estimación
#               estocástica de residuos y conos de cuantiles idénticos a TimesFM.
#   - timesfm : Motor basado en Google TimesFM (PyTorch).
FORECAST_ENGINE=mock

# Permitir que EngineSelector use el modelo real Google TimesFM 2.5 (200M) vía
# PyTorch, PARA LAS SERIES DONDE UN BENCHMARK REAL CONFIRMÓ QUE GANA:
#   - true (predeterminado): si los pesos están disponibles (requiere instalar
#            requirements-timesfm.txt y que 'google/timesfm-2.5-200m-pytorch'
#            esté descargado/cacheado), las 4 series FRED estacionales del
#            catálogo (IPG2211A2N, RSAFSNA, HOUSTNSA, MRTSSM4451USN) lo usan.
#            Si los pesos NO están disponibles (ej. la imagen Docker default,
#            deliberadamente liviana), esas mismas series caen a Damped Holt de
#            forma transparente y sin reintentar la carga en cada request — no
#            hay downside en dejarlo en true incluso sin los pesos instalados.
#   - false : fuerza Holt incluso para esas 4 series (equivalente a no tener
#             los pesos disponibles).
#
# IMPORTANTE: esta flag NO es un interruptor global de "TimesFM para todo".
# El endpoint /api/forecast usa EngineSelector (backend/services/engine_selector.py),
# que elige Holt o TimesFM POR SERIE según qué ganó en un benchmark walk-forward
# real (scripts/benchmark_real_data.py) — no según esta variable sola. Con esta
# flag en true, TODO LO DEMÁS (índices/ETF diversificados, historia corta,
# acciones individuales) sigue en Holt de cualquier forma, porque el benchmark
# mostró que TimesFM no les gana ahí — así que activarla no dispara un uso
# masivo del modelo pesado, solo lo habilita para el puñado de casos donde ya
# está confirmado que corresponde. Ver README.md ("Selección de motor de
# proyección") y docs/ARCHITECTURE.md para la tabla completa y el benchmark.
USE_REAL_TIMESFM=true

# ------------------------------------------------------------------------------
# 6. CACHÉ EN MEMORIA
# ------------------------------------------------------------------------------
# Tiempo de vida de la caché (en segundos) para series de yfinance y FRED.
CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# 7. INTEGRIDAD DE DATOS (Guard Anti-Fabricación)
# ------------------------------------------------------------------------------
# Controla si el sistema puede generar series sintéticas cuando yfinance o FRED
# fallan o no tienen clave configurada.
#   - false (predeterminado y recomendado): el sistema falla explícitamente en
#     vez de inventar datos. Backtest, Correlación, Optimización de Cartera y
#     Riesgo quedan bloqueados si la serie activa no es real.
#   - true: habilita generadores de referencia/sintéticos para poder explorar
#     la interfaz sin conexión ni claves de API. TODA vista que use estos datos
#     muestra un banner de advertencia no descartable y bloquea el análisis
#     cuantitativo serio (Reality Check, Correlaciones, Cartera, Riesgo).
#     Usar solo para demos o desarrollo offline, nunca para decisiones reales.
ALLOW_SYNTHETIC_DATA=false
