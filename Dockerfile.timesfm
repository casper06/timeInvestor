# Multi-stage Dockerfile for TimeInvestor with Google TimesFM (PyTorch + CUDA GPU Acceleration)
# Stage 1: Build React 19 / Vite frontend
FROM node:20-slim AS frontend-builder
WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# Stage 2: Python 3.12 runtime with PyTorch CUDA and TimesFM support
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RUNNING_IN_DOCKER=1 \
    HOST=0.0.0.0 \
    PORT=8000 \
    USE_REAL_TIMESFM=true \
    FORECAST_ENGINE=timesfm \
    HF_HOME=/app/.cache/huggingface

WORKDIR /app

# Install system dependencies (curl for healthcheck, git for HF if needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged system user
RUN groupadd -r appgroup && useradd -r -g appgroup -d /app -s /sbin/nologin appuser

# Install standard backend requirements, exact versions from the lock
COPY requirements.lock requirements-timesfm.txt ./
RUN pip install --no-cache-dir -r requirements.lock

# Install PyTorch with CUDA 12.1 support FIRST (from the CUDA wheel index), then
# the rest of requirements-timesfm.txt — including the `timesfm` package itself,
# which provides TimesFM_2p5_200M_torch and is what TimesFMForecastEngine actually
# imports. requirements-timesfm.txt's own torch constraint (>=2.0.0,<3.0.0) is
# already satisfied by the CUDA build installed here, so pip won't reinstall or
# downgrade it to a CPU wheel when it processes that file next.
#
# requirements-timesfm.txt stays out of the lock (torch's wheel depends on the
# hardware: CUDA here, CPU elsewhere), but `-c requirements.lock` keeps it from
# moving any of the locked shared dependencies (numpy, pandas, ...).
RUN pip install --no-cache-dir -c requirements.lock \
    torch --index-url https://download.pytorch.org/whl/cu121 \
    && pip install --no-cache-dir -r requirements-timesfm.txt -c requirements.lock

# Copy application backend, execution scripts, and launcher
COPY backend/ ./backend/
COPY scripts/ ./scripts/
COPY run.py ./

# Copy compiled frontend from Stage 1
COPY --from=frontend-builder /app/frontend/dist /app/frontend/dist

# Create SQLite database directory and cache directory with proper ownership
RUN mkdir -p /app/backend/database /app/.cache/huggingface \
    && chown -R appuser:appgroup /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

CMD ["python", "run.py", "--no-browser", "--host", "0.0.0.0", "--port", "8000"]
